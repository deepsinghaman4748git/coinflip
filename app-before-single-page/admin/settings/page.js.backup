"use client";

import { useEffect, useState } from "react";

export default function AdminSettingsPage() {
  const [gameEnabled, setGameEnabled] = useState(true);
  const [maintenance, setMaintenance] = useState(false);
  const [minBet, setMinBet] = useState("10");
  const [maxBet, setMaxBet] = useState("10000");
  const [payout, setPayout] = useState("2");

  const [message, setMessage] = useState("");
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);

  // =========================
  // LOAD SETTINGS
  // =========================

  async function loadSettings() {
    try {
      setLoading(true);
      setMessage("");

      const response = await fetch(
        "/api/admin/settings",
        {
          cache: "no-store",
        }
      );

      const data = await response.json();

      if (!response.ok || !data.success) {
        setMessage(
          data.message || "Unable to load settings"
        );
        return;
      }

      const settings = data.settings;

      setGameEnabled(
        settings?.coinflipEnabled ?? true
      );

      setMaintenance(
        settings?.maintenanceMode ?? false
      );

      setMinBet(
        String(settings?.minBet ?? 10)
      );

      setMaxBet(
        String(settings?.maxBet ?? 10000)
      );

      setPayout(
        String(settings?.payoutMultiplier ?? 2)
      );
    } catch (error) {
      console.error(
        "Settings loading error:",
        error
      );

      setMessage("Unable to load settings");
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadSettings();
  }, []);

  // =========================
  // SAVE SETTINGS
  // =========================

  async function saveSettings() {
    const minimum = Number(minBet);
    const maximum = Number(maxBet);
    const multiplier = Number(payout);

    if (!Number.isFinite(minimum) || minimum < 1) {
      setMessage("Minimum bet must be at least ₹1");
      return;
    }

    if (
      !Number.isFinite(maximum) ||
      maximum < minimum
    ) {
      setMessage(
        "Maximum bet must be greater than minimum bet"
      );
      return;
    }

    if (
      !Number.isFinite(multiplier) ||
      multiplier < 1
    ) {
      setMessage(
        "Payout multiplier must be at least 1"
      );
      return;
    }

    try {
      setSaving(true);
      setMessage("");

      const response = await fetch(
        "/api/admin/settings",
        {
          method: "PUT",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            coinflipEnabled: gameEnabled,
            maintenanceMode: maintenance,
            minBet: minimum,
            maxBet: maximum,
            payoutMultiplier: multiplier,
          }),
        }
      );

      const data = await response.json();

      if (!response.ok || !data.success) {
        setMessage(
          data.message ||
            "Unable to save settings"
        );
        return;
      }

      // Update UI with database values
      const settings = data.settings;

      setGameEnabled(
        settings?.coinflipEnabled ?? gameEnabled
      );

      setMaintenance(
        settings?.maintenanceMode ?? maintenance
      );

      setMinBet(
        String(settings?.minBet ?? minimum)
      );

      setMaxBet(
        String(settings?.maxBet ?? maximum)
      );

      setPayout(
        String(
          settings?.payoutMultiplier ??
            multiplier
        )
      );

      setMessage(
        "Settings saved successfully."
      );

      setTimeout(() => {
        setMessage("");
      }, 3000);
    } catch (error) {
      console.error(
        "Settings saving error:",
        error
      );

      setMessage(
        "Unable to save settings"
      );
    } finally {
      setSaving(false);
    }
  }

  // =========================
  // LOADING
  // =========================

  if (loading) {
    return (
      <div className="min-h-screen bg-[#0B1120] text-white flex items-center justify-center">
        <div className="text-center">
          <div className="text-3xl mb-3">
            ⚙️
          </div>

          <p className="text-gray-400">
            Loading settings...
          </p>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-[#0B1120] text-white p-6 md:p-8">

      <div className="max-w-5xl mx-auto">

        {/* Header */}

        <div className="mb-8">

          <h1 className="text-4xl font-bold text-yellow-400">
            Settings
          </h1>

          <p className="text-gray-400 mt-2">
            Manage CoinFlip game settings
          </p>

        </div>

        {/* Message */}

        {message && (
          <div
            className={`mb-6 rounded-xl p-4 border ${
              message.includes("successfully")
                ? "bg-green-500/10 border-green-500/30 text-green-400"
                : "bg-red-500/10 border-red-500/30 text-red-400"
            }`}
          >
            {message}
          </div>
        )}

        {/* Game Status */}

        <div className="bg-[#111827] border border-gray-800 rounded-2xl p-6 mb-6">

          <h2 className="text-2xl font-bold text-yellow-400 mb-6">
            Game Status
          </h2>

          <div className="space-y-5">

            {/* Game Enabled */}

            <div className="flex items-center justify-between gap-4">

              <div>

                <h3 className="font-bold">
                  CoinFlip Game
                </h3>

                <p className="text-gray-500 text-sm mt-1">
                  Allow users to play CoinFlip
                </p>

              </div>

              <button
                type="button"
                disabled={saving}
                onClick={() =>
                  setGameEnabled(!gameEnabled)
                }
                className={`relative w-14 h-7 rounded-full transition ${
                  gameEnabled
                    ? "bg-green-500"
                    : "bg-gray-600"
                }`}
              >

                <span
                  className={`absolute top-1 w-5 h-5 bg-white rounded-full transition ${
                    gameEnabled
                      ? "left-8"
                      : "left-1"
                  }`}
                />

              </button>

            </div>

            {/* Maintenance */}

            <div className="flex items-center justify-between gap-4 border-t border-gray-800 pt-5">

              <div>

                <h3 className="font-bold">
                  Maintenance Mode
                </h3>

                <p className="text-gray-500 text-sm mt-1">
                  Temporarily disable game access
                </p>

              </div>

              <button
                type="button"
                disabled={saving}
                onClick={() =>
                  setMaintenance(!maintenance)
                }
                className={`relative w-14 h-7 rounded-full transition ${
                  maintenance
                    ? "bg-red-500"
                    : "bg-gray-600"
                }`}
              >

                <span
                  className={`absolute top-1 w-5 h-5 bg-white rounded-full transition ${
                    maintenance
                      ? "left-8"
                      : "left-1"
                  }`}
                />

              </button>

            </div>

          </div>

        </div>

        {/* Betting Settings */}

        <div className="bg-[#111827] border border-gray-800 rounded-2xl p-6 mb-6">

          <h2 className="text-2xl font-bold text-yellow-400 mb-6">
            Betting Settings
          </h2>

          <div className="grid md:grid-cols-3 gap-5">

            {/* Minimum */}

            <div>

              <label className="text-gray-400 text-sm">
                Minimum Bet
              </label>

              <div className="relative mt-2">

                <span className="absolute left-4 top-3 text-gray-500">
                  ₹
                </span>

                <input
                  type="number"
                  min="1"
                  disabled={saving}
                  value={minBet}
                  onChange={(e) =>
                    setMinBet(e.target.value)
                  }
                  className="w-full bg-[#1F2937] border border-gray-700 rounded-xl pl-9 pr-4 py-3 outline-none focus:border-yellow-500"
                />

              </div>

            </div>

            {/* Maximum */}

            <div>

              <label className="text-gray-400 text-sm">
                Maximum Bet
              </label>

              <div className="relative mt-2">

                <span className="absolute left-4 top-3 text-gray-500">
                  ₹
                </span>

                <input
                  type="number"
                  min="1"
                  disabled={saving}
                  value={maxBet}
                  onChange={(e) =>
                    setMaxBet(e.target.value)
                  }
                  className="w-full bg-[#1F2937] border border-gray-700 rounded-xl pl-9 pr-4 py-3 outline-none focus:border-yellow-500"
                />

              </div>

            </div>

            {/* Payout */}

            <div>

              <label className="text-gray-400 text-sm">
                Payout Multiplier
              </label>

              <div className="relative mt-2">

                <input
                  type="number"
                  step="0.1"
                  min="1"
                  disabled={saving}
                  value={payout}
                  onChange={(e) =>
                    setPayout(e.target.value)
                  }
                  className="w-full bg-[#1F2937] border border-gray-700 rounded-xl px-4 py-3 outline-none focus:border-yellow-500"
                />

              </div>

              <p className="text-xs text-gray-500 mt-2">
                Example: 2x means ₹100 bet pays ₹200 on win.
              </p>

            </div>

          </div>

        </div>

        {/* Current Settings */}

        <div className="bg-[#111827] border border-gray-800 rounded-2xl p-6 mb-6">

          <h2 className="text-2xl font-bold text-yellow-400 mb-5">
            Current Settings
          </h2>

          <div className="grid md:grid-cols-2 gap-4">

            {/* Game Status */}

            <div className="bg-[#1F2937] rounded-xl p-4">

              <p className="text-gray-500 text-sm">
                Game Status
              </p>

              <p
                className={`font-bold mt-1 ${
                  gameEnabled
                    ? "text-green-400"
                    : "text-red-400"
                }`}
              >
                {gameEnabled
                  ? "Enabled"
                  : "Disabled"}
              </p>

            </div>

            {/* Maintenance */}

            <div className="bg-[#1F2937] rounded-xl p-4">

              <p className="text-gray-500 text-sm">
                Maintenance
              </p>

              <p
                className={`font-bold mt-1 ${
                  maintenance
                    ? "text-red-400"
                    : "text-green-400"
                }`}
              >
                {maintenance
                  ? "ON"
                  : "OFF"}
              </p>

            </div>

            {/* Minimum */}

            <div className="bg-[#1F2937] rounded-xl p-4">

              <p className="text-gray-500 text-sm">
                Minimum Bet
              </p>

              <p className="font-bold mt-1">
                ₹
                {Number(
                  minBet || 0
                ).toFixed(2)}
              </p>

            </div>

            {/* Maximum */}

            <div className="bg-[#1F2937] rounded-xl p-4">

              <p className="text-gray-500 text-sm">
                Maximum Bet
              </p>

              <p className="font-bold mt-1">
                ₹
                {Number(
                  maxBet || 0
                ).toFixed(2)}
              </p>

            </div>

            {/* Payout */}

            <div className="bg-[#1F2937] rounded-xl p-4 md:col-span-2">

              <p className="text-gray-500 text-sm">
                Payout Multiplier
              </p>

              <p className="font-bold text-yellow-400 mt-1">
                {Number(
                  payout || 0
                ).toFixed(2)}x
              </p>

            </div>

          </div>

        </div>

        {/* Save Button */}

        <div className="flex justify-end">

          <button
            type="button"
            onClick={saveSettings}
            disabled={saving}
            className="bg-yellow-500 hover:bg-yellow-400 disabled:bg-gray-600 disabled:text-gray-300 text-black font-bold px-8 py-4 rounded-xl transition"
          >
            {saving
              ? "Saving..."
              : "Save Settings"}
          </button>

        </div>

      </div>

    </div>
  );
}