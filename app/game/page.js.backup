"use client";

import { useEffect, useState } from "react";

export default function GamePage() {
  const [choice, setChoice] = useState("");
  const [result, setResult] = useState(null);
  const [coin, setCoin] = useState(null);
  const [isFlipping, setIsFlipping] = useState(false);
  const [loading, setLoading] = useState(false);

  const [bet, setBet] = useState("");
  const [walletBalance, setWalletBalance] = useState(0);

  const [history, setHistory] = useState([]);
  const [historyLoading, setHistoryLoading] = useState(true);

  async function loadWallet() {
    try {
      const response = await fetch("/api/me", {
        cache: "no-store",
      });

      const data = await response.json();

      if (data.success && data.user) {
        setWalletBalance(Number(data.user.walletBalance || 0));
      }
    } catch (error) {
      console.error("Wallet loading error:", error);
    }
  }

  async function loadHistory() {
    try {
      setHistoryLoading(true);

      const response = await fetch("/api/game/history", {
        cache: "no-store",
      });

      const data = await response.json();

      if (data.success) {
        setHistory(data.games || []);
      }
    } catch (error) {
      console.error("Game history loading error:", error);
    } finally {
      setHistoryLoading(false);
    }
  }

  useEffect(() => {
    loadWallet();
    loadHistory();
  }, []);

  function selectBet(amount) {
    if (loading) return;

    setBet(String(amount));
    setResult(null);
  }

  async function flipCoin() {
    if (loading) return;

    if (!choice) {
      alert("Please select RUPEE or BHARAT");
      return;
    }

    const amount = Number(bet);

    if (!Number.isFinite(amount) || amount <= 0) {
      alert("Enter a valid bet amount");
      return;
    }

    if (amount < 10) {
      alert("Minimum entry fee is ₹10");
      return;
    }

    if (amount > walletBalance) {
      alert("Insufficient wallet balance");
      return;
    }

    setLoading(true);
    setIsFlipping(true);
    setResult(null);
    setCoin(null);

    try {
      /*
       * Animation first.
       * Final result is ALWAYS taken from the server.
       */
      await new Promise((resolve) => setTimeout(resolve, 1800));

      const response = await fetch("/api/game/coinflip", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          /*
           * Database/API still uses:
           * heads = RUPEE
           * tails = BHARAT
           */
          prediction: choice === "Head" ? "heads" : "tails",
          entryFee: amount,
        }),
      });

      const data = await response.json();

      if (!response.ok || !data.success) {
        alert(data.message || "Unable to play game");

        setCoin(null);
        setIsFlipping(false);

        return;
      }

      const game = data.game;

      /*
       * SERVER RESULT
       *
       * heads -> RUPEE
       * tails -> BHARAT
       */
      const finalResult =
        game.result === "heads" ? "heads" : "tails";

      setCoin(finalResult);
      setIsFlipping(false);

      setResult({
        won: game.status === "won",

        prediction:
          game.prediction === "heads"
            ? "RUPEE"
            : "BHARAT",

        result:
          game.result === "heads"
            ? "RUPEE"
            : "BHARAT",

        rawPrediction: game.prediction,
        rawResult: game.result,

        entryFee: Number(game.entryFee || 0),
        winAmount: Number(game.winAmount || 0),
      });

      setWalletBalance(Number(data.walletBalance || 0));

      setBet("");

      /*
       * IMPORTANT:
       * History is only refreshed.
       * Nothing is deleted.
       */
      await loadHistory();
      await loadWallet();
    } catch (error) {
      console.error("CoinFlip error:", error);

      alert("Something went wrong. Please try again.");

      setCoin(null);
    } finally {
      setIsFlipping(false);
      setLoading(false);
    }
  }

  function resetGame() {
    if (loading) return;

    setChoice("");
    setResult(null);
    setCoin(null);
    setBet("");
    setIsFlipping(false);
  }

  function formatDate(date) {
    if (!date) return "-";

    return new Date(date).toLocaleString("en-IN", {
      day: "2-digit",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  /*
   * Convert database values into the new UI names.
   *
   * heads -> ₹ RUPEE
   * tails -> 🇮🇳 BHARAT
   */
  function getSideName(value) {
    return value === "heads" ? "RUPEE" : "BHARAT";
  }

  function getSideIcon(value) {
    return value === "heads" ? "₹" : "🇮🇳";
  }

  return (
    <div className="min-h-screen bg-[#070B14] text-white px-4 py-6 md:py-10">

      <div className="max-w-6xl mx-auto">

        {/* ================= TOP HEADER ================= */}

        <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-5 mb-8">

          <div>
            <div className="flex items-center gap-3">

              {/* MINI COIN */}

              <div className="w-12 h-12 rounded-2xl bg-yellow-500/10 border border-yellow-500/20 flex items-center justify-center">

                <div
                  className="relative w-10 h-10 rounded-full flex items-center justify-center"
                  style={{
                    background:
                      "radial-gradient(circle at 35% 30%, #fff4a8 0%, #facc15 25%, #d99a00 55%, #8a5a00 100%)",

                    boxShadow:
                      "inset 0 0 0 2px rgba(255,255,255,.35), inset 0 -3px 5px rgba(0,0,0,.35), 0 4px 10px rgba(234,179,8,.35)",
                  }}
                >

                  <div
                    className="absolute inset-[3px] rounded-full border"
                    style={{
                      borderColor: "rgba(255,255,255,.35)",
                    }}
                  />

                  <span
                    className="relative text-black font-black text-lg"
                    style={{
                      textShadow:
                        "0 1px 1px rgba(255,255,255,.35)",
                    }}
                  >
                    ₹
                  </span>

                </div>

              </div>

              <div>

                <h1 className="text-3xl md:text-4xl font-black text-yellow-400">
                  CoinFlip
                </h1>

                <p className="text-gray-500 text-sm">
                  Rupee or Bharat
                </p>

              </div>

            </div>
          </div>

          {/* ================= WALLET ================= */}

          <div className="bg-[#111827] border border-green-500/20 rounded-2xl px-6 py-4 min-w-[190px]">

            <p className="text-gray-500 text-xs uppercase tracking-wider">
              Wallet Balance
            </p>

            <p className="text-2xl font-black text-green-400 mt-1">
              ₹{walletBalance.toFixed(2)}
            </p>

          </div>

        </div>

        {/* ================= MAIN GRID ================= */}

        <div className="grid lg:grid-cols-2 gap-7">

          {/* ================= GAME ================= */}

          <div className="bg-[#111827] border border-white/5 rounded-3xl p-6 md:p-8 shadow-2xl">

            <div className="text-center">

              <span className="inline-block px-4 py-1.5 rounded-full bg-yellow-500/10 border border-yellow-500/20 text-yellow-400 text-xs font-bold">
                2X PAYOUT
              </span>

              <h2 className="text-2xl font-bold mt-4">
                Predict the Coin
              </h2>

              <p className="text-gray-500 text-sm mt-2">
                Choose RUPEE or BHARAT and enter your stake
              </p>

            </div>

            {/* ================= 3D COIN ================= */}

            <div className="flex justify-center mt-8">

              <div
                className="relative w-44 h-44 md:w-52 md:h-52"
                style={{
                  perspective: "1000px",
                }}
              >

                <div
                  className="relative w-full h-full"
                  style={{
                    transformStyle: "preserve-3d",

                    transform: isFlipping
                      ? undefined
                      : coin === "tails"
                      ? "rotateY(180deg)"
                      : "rotateY(0deg)",

                    animation: isFlipping
                      ? "coinFlip 1.8s cubic-bezier(.2,.8,.2,1)"
                      : "none",
                  }}
                >

                  {/* ================= RUPEE / HEAD ================= */}

                  <div
                    className="absolute inset-0 rounded-full flex flex-col items-center justify-center overflow-hidden"
                    style={{
                      backfaceVisibility: "hidden",

                      background:
                        "radial-gradient(circle at 32% 25%, #fff7b2 0%, #ffe45c 20%, #f5bd16 48%, #c98500 75%, #815000 100%)",

                      border:
                        "10px solid rgba(255,230,120,.65)",

                      boxShadow:
                        "inset 8px 8px 18px rgba(255,255,255,.55), inset -12px -15px 25px rgba(70,40,0,.45), 0 15px 40px rgba(0,0,0,.5), 0 0 55px rgba(250,190,20,.25)",
                    }}
                  >

                    <div
                      className="absolute inset-3 rounded-full"
                      style={{
                        border:
                          "2px solid rgba(255,248,190,.55)",

                        boxShadow:
                          "inset 0 0 0 2px rgba(120,70,0,.25)",
                      }}
                    />

                    <div
                      className="absolute inset-6 rounded-full"
                      style={{
                        border:
                          "1px solid rgba(100,60,0,.25)",
                      }}
                    />

                    <div
                      className="relative text-7xl md:text-8xl font-black"
                      style={{
                        color: "#704500",

                        textShadow:
                          "2px 3px 2px rgba(255,245,170,.55), -1px -1px 1px rgba(70,40,0,.35)",
                      }}
                    >
                      ₹
                    </div>

                    <div
                      className="relative mt-1 text-xs md:text-sm font-black tracking-[0.35em]"
                      style={{
                        color: "#704500",
                      }}
                    >
                      RUPEE
                    </div>

                    <div
                      className="absolute bottom-5 text-[9px] font-black tracking-[0.3em]"
                      style={{
                        color: "rgba(80,45,0,.65)",
                      }}
                    >
                      HEAD
                    </div>

                  </div>

                  {/* ================= BHARAT / TAIL ================= */}

                  <div
                    className="absolute inset-0 rounded-full flex flex-col items-center justify-center overflow-hidden"
                    style={{
                      backfaceVisibility: "hidden",

                      transform: "rotateY(180deg)",

                      background:
                        "radial-gradient(circle at 32% 25%, #fff7b2 0%, #ffe45c 20%, #f5bd16 48%, #c98500 75%, #815000 100%)",

                      border:
                        "10px solid rgba(255,230,120,.65)",

                      boxShadow:
                        "inset 8px 8px 18px rgba(255,255,255,.55), inset -12px -15px 25px rgba(70,40,0,.45), 0 15px 40px rgba(0,0,0,.5), 0 0 55px rgba(250,190,20,.25)",
                    }}
                  >

                    <div
                      className="absolute inset-3 rounded-full"
                      style={{
                        border:
                          "2px solid rgba(255,248,190,.55)",

                        boxShadow:
                          "inset 0 0 0 2px rgba(120,70,0,.25)",
                      }}
                    />

                    <div
                      className="absolute inset-6 rounded-full"
                      style={{
                        border:
                          "1px solid rgba(100,60,0,.25)",
                      }}
                    />

                    <div className="relative text-4xl md:text-5xl">
                      🇮🇳
                    </div>

                    <div
                      className="relative mt-2 text-2xl md:text-3xl font-black tracking-wider"
                      style={{
                        color: "#704500",

                        textShadow:
                          "1px 2px 1px rgba(255,245,170,.55)",
                      }}
                    >
                      BHARAT
                    </div>

                    <div
                      className="absolute bottom-5 text-[9px] font-black tracking-[0.3em]"
                      style={{
                        color: "rgba(80,45,0,.65)",
                      }}
                    >
                      TAIL
                    </div>

                  </div>

                </div>

              </div>

            </div>

            {/* ================= COIN ANIMATION ================= */}

            <style jsx>{`
              @keyframes coinFlip {
                0% {
                  transform: rotateY(0deg) scale(1);
                }

                20% {
                  transform: rotateY(360deg) scale(1.05);
                }

                40% {
                  transform: rotateY(720deg) scale(1.08);
                }

                60% {
                  transform: rotateY(1080deg) scale(1.05);
                }

                80% {
                  transform: rotateY(1440deg) scale(1.03);
                }

                100% {
                  transform: rotateY(1800deg) scale(1);
                }
              }
            `}</style>

            {/* ================= COIN STATUS ================= */}

            <p className="text-center text-gray-500 mt-5 text-sm">

              {loading
                ? "Flipping the coin..."

                : result
                ? result.result === "RUPEE"
                  ? "₹ RUPEE — HEAD"
                  : "🇮🇳 BHARAT — TAIL"

                : "Select RUPEE or BHARAT"}

            </p>

            {/* ================= BET AMOUNT ================= */}

            <div className="mt-8">

              <label className="text-gray-300 text-sm font-medium">
                Entry Fee
              </label>

              <div className="relative mt-2">

                <span className="absolute left-4 top-3.5 text-gray-400">
                  ₹
                </span>

                <input
                  type="number"
                  min="10"
                  placeholder="Enter amount"
                  value={bet}
                  onChange={(e) => setBet(e.target.value)}
                  disabled={loading}
                  className="w-full bg-[#0B1120] border border-gray-700 focus:border-yellow-500 rounded-xl pl-9 pr-4 py-3.5 outline-none transition"
                />

              </div>

              {/* ================= QUICK BET ================= */}

              <div className="grid grid-cols-4 gap-2 mt-3">

                {[10, 50, 100, 500].map((amount) => (

                  <button
                    key={amount}
                    type="button"
                    disabled={loading}
                    onClick={() => selectBet(amount)}
                    className={`py-2 rounded-lg text-sm font-bold transition ${
                      Number(bet) === amount
                        ? "bg-yellow-500 text-black"
                        : "bg-[#1F2937] hover:bg-gray-700 text-gray-300"
                    }`}
                  >
                    ₹{amount}
                  </button>

                ))}

              </div>

              <p className="text-xs text-gray-600 mt-2">
                Minimum entry fee: ₹10
              </p>

            </div>

            {/* ================= CHOICES ================= */}

            <div className="grid grid-cols-2 gap-4 mt-6">

              <button
                type="button"
                disabled={loading}
                onClick={() => setChoice("Head")}
                className={`py-5 rounded-2xl font-black text-lg transition border ${
                  choice === "Head"
                    ? "bg-yellow-500 text-black border-yellow-400 shadow-lg shadow-yellow-500/20"
                    : "bg-[#1F2937] hover:bg-gray-700 border-gray-700"
                }`}
              >
                ₹ RUPEE
              </button>

              <button
                type="button"
                disabled={loading}
                onClick={() => setChoice("Tail")}
                className={`py-5 rounded-2xl font-black text-lg transition border ${
                  choice === "Tail"
                    ? "bg-yellow-500 text-black border-yellow-400 shadow-lg shadow-yellow-500/20"
                    : "bg-[#1F2937] hover:bg-gray-700 border-gray-700"
                }`}
              >
                🇮🇳 BHARAT
              </button>

            </div>

            {/* ================= PLAY BUTTON ================= */}

            <button
              type="button"
              onClick={flipCoin}
              disabled={loading}
              className="w-full mt-6 bg-green-500 hover:bg-green-600 active:scale-[0.99] disabled:bg-gray-700 disabled:text-gray-500 py-4 rounded-2xl font-black text-lg transition shadow-lg shadow-green-500/10"
            >
              {loading
                ? "🪙 Flipping..."
                : "🎯 Flip Coin"}
            </button>

            {/* ================= RESULT ================= */}

            {result && (

              <div
                className={`mt-6 rounded-2xl p-5 text-center border ${
                  result.won
                    ? "bg-green-500/10 border-green-500/30"
                    : "bg-red-500/10 border-red-500/30"
                }`}
              >

                <div className="text-3xl font-black">

                  {result.won
                    ? "🎉 YOU WON!"
                    : "😢 YOU LOST!"}

                </div>

                <div className="grid grid-cols-2 gap-3 mt-5">

                  <div className="bg-black/20 rounded-xl p-3">

                    <p className="text-gray-500 text-xs">
                      YOUR PICK
                    </p>

                    <p className="font-bold mt-1">

                      {getSideIcon(result.rawPrediction)}{" "}
                      {result.prediction}

                    </p>

                  </div>

                  <div className="bg-black/20 rounded-xl p-3">

                    <p className="text-gray-500 text-xs">
                      RESULT
                    </p>

                    <p className="font-bold text-yellow-400 mt-1">

                      {getSideIcon(result.rawResult)}{" "}
                      {result.result}

                    </p>

                  </div>

                </div>

                <div className="mt-4 text-sm">

                  <span className="text-gray-400">
                    Entry: ₹{result.entryFee.toFixed(2)}
                  </span>

                  <span className="mx-2 text-gray-600">
                    •
                  </span>

                  <span
                    className={
                      result.won
                        ? "text-green-400 font-bold"
                        : "text-red-400 font-bold"
                    }
                  >

                    {result.won
                      ? `Payout: ₹${result.winAmount.toFixed(2)}`
                      : `Lost: ₹${result.entryFee.toFixed(2)}`}

                  </span>

                </div>

                <button
                  type="button"
                  onClick={resetGame}
                  className="mt-5 px-6 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 text-sm font-bold"
                >
                  🔄 Play Again
                </button>

              </div>

            )}

          </div>

          {/* ================= HISTORY ================= */}

          <div className="bg-[#111827] border border-white/5 rounded-3xl p-6 md:p-7">

            <div className="flex items-center justify-between gap-3 mb-6">

              <div>

                <h2 className="text-2xl font-black text-yellow-400">
                  Game History
                </h2>

                <p className="text-gray-500 text-sm mt-1">
                  Your recent CoinFlip rounds
                </p>

              </div>

              <button
                type="button"
                disabled={historyLoading}
                onClick={() => {
                  loadHistory();
                  loadWallet();
                }}
                className="bg-[#1F2937] hover:bg-gray-700 px-4 py-2 rounded-xl text-sm font-bold"
              >
                🔄 Refresh
              </button>

            </div>

            {historyLoading ? (

              <div className="text-center py-16 text-gray-500">
                Loading history...
              </div>

            ) : history.length === 0 ? (

              <div className="text-center py-16">

                <div className="text-6xl">
                  🎮
                </div>

                <p className="text-gray-400 mt-4 font-semibold">
                  No games played yet
                </p>

                <p className="text-gray-600 text-sm mt-1">
                  Your recent games will appear here
                </p>

              </div>

            ) : (

              <div className="space-y-3 max-h-[650px] overflow-y-auto pr-1">

                {history.map((game) => {

                  const won = game.status === "won";

                  const predictionName =
                    getSideName(game.prediction);

                  const resultName =
                    getSideName(game.result);

                  return (

                    <div
                      key={game._id}
                      className="bg-[#0B1120] rounded-2xl p-4 border border-gray-800 hover:border-gray-700 transition"
                    >

                      <div className="flex items-center justify-between gap-3">

                        <div>

                          <div className="flex items-center gap-2">

                            <span className="font-black">

                              {getSideIcon(game.prediction)}{" "}
                              {predictionName}

                            </span>

                            <span className="text-gray-600">
                              →
                            </span>

                            <span className="text-yellow-400 font-black">

                              {getSideIcon(game.result)}{" "}
                              {resultName}

                            </span>

                          </div>

                          <p className="text-gray-600 text-xs mt-1">
                            {formatDate(game.createdAt)}
                          </p>

                        </div>

                        <div className="text-right">

                          <p
                            className={`font-black text-sm ${
                              won
                                ? "text-green-400"
                                : "text-red-400"
                            }`}
                          >
                            {won ? "WON" : "LOST"}
                          </p>

                          <p className="text-gray-500 text-sm">
                            ₹
                            {Number(
                              game.entryFee || 0
                            ).toFixed(2)}
                          </p>

                        </div>

                      </div>

                      <div className="border-t border-gray-800 mt-3 pt-3 flex justify-between text-sm">

                        <span className="text-gray-600">
                          Payout
                        </span>

                        <span
                          className={
                            won
                              ? "text-green-400 font-bold"
                              : "text-gray-600"
                          }
                        >
                          ₹
                          {Number(
                            game.winAmount || 0
                          ).toFixed(2)}
                        </span>

                      </div>

                    </div>

                  );

                })}

              </div>

            )}

          </div>

        </div>

        {/* ================= INFO ================= */}

        <div className="mt-7 bg-[#111827] border border-yellow-500/10 rounded-2xl p-4 text-center">

          <p className="text-gray-500 text-xs">
            Minimum entry ₹10 • Win payout 2× entry fee
          </p>

        </div>

      </div>

    </div>
  );
}